{
  "name": "brick-by-script-learn",
  "version": "1.2.0",
  "description": "Learn Lua and build FiveM resources with Brick by Script Learn.",
  "author": "Brick by Script",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:browser": "node scripts/browser-profile-test.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --dir --win --x64"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wasmoon": "^1.16.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "45.3.4",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  },
  "build": {
    "appId": "dev.fivem.academy",
    "productName": "Brick by Script Learn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraFiles": [
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": true
  }
}
